      "pluginVersion": "9.3.2",
      "targets": [{"datasource": {"type": "influxdb", "uid": "peOmMbNIz"}, "query": "import \"strings\"\nfrom(bucket: \"energy\")\n  |> range(start: -6h)\n  |> filter(fn: (r) => r._field == \"value\")\n  |> filter(fn: (r) => r._measurement == \"W\" or r._measurement == \"A\" or r._measurement == \"V\" or r._measurement == \"kWh\")\n  |> filter(fn: (r) => r.entity_id =~ /${breaker:regex}/)\n  |> map(fn: (r) => ({r with entity_id:\n      if r._measurement == \"W\" then strings.trimSuffix(v: strings.trimPrefix(v: r.entity_id, prefix: \"circuit_breaker_\"), suffix: \"_power\")\n      else if r._measurement == \"A\" then strings.trimSuffix(v: strings.trimPrefix(v: r.entity_id, prefix: \"circuit_breaker_\"), suffix: \"_current\")\n      else if r._measurement == \"V\" then strings.trimSuffix(v: strings.trimPrefix(v: r.entity_id, prefix: \"circuit_breaker_\"), suffix: \"_voltage\")\n      else strings.trimSuffix(v: strings.trimPrefix(v: r.entity_id, prefix: \"circuit_breaker_\"), suffix: \"_total_energy\")}))\n  |> group(columns: [\"entity_id\", \"_measurement\"])\n  |> last()\n  |> pivot(rowKey: [\"entity_id\"], columnKey: [\"_measurement\"], valueColumn: \"_value\")\n  |> group()\n  |> rename(columns: {W: \"Power (W)\", A: \"Current (A)\", V: \"Voltage (V)\", kWh: \"Energy (kWh)\"})\n  |> keep(columns: [\"entity_id\", \"Power (W)\", \"Current (A)\", \"Voltage (V)\", \"Energy (kWh)\"])", "refId": "A"}],
