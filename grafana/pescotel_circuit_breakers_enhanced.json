{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB",
      "description": "InfluxDB 2.x with Flux — org: grafana, bucket: energy",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    { "type": "grafana",    "id": "grafana",    "name": "Grafana",    "version": "9.0.0" },
    { "type": "datasource", "id": "influxdb",   "name": "InfluxDB",   "version": "1.0.0" },
    { "type": "panel", "id": "stat",       "name": "Stat",       "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series","version": "" },
    { "type": "panel", "id": "table",      "name": "Table",      "version": "" },
    { "type": "panel", "id": "barchart",   "name": "Bar chart",  "version": "" },
    { "type": "panel", "id": "gauge",      "name": "Gauge",      "version": "" },
    { "type": "panel", "id": "bargauge",   "name": "Bar gauge",  "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Pescotel — Circuit Breakers enhanced dashboard. All old panels + fleet table, top consumers, load gauges, cost projections.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "id": 100,
      "type": "row",
      "title": "Live Summary",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },

    {
      "id": 1, "type": "stat",
      "title": "Total Power",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{ "refId": "A", "query": "from(bucket: \"energy\")\n  |> range(start: -3m)\n  |> filter(fn: (r) => r._measurement == \"W\" and r._field == \"value\")\n  |> last()\n  |> sum()\n  |> map(fn: (r) => ({r with _value: r._value / 1000.0}))" }],
      "fieldConfig": { "defaults": { "unit": "kwatt", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "blue" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"red","value":10}] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto", "justifyMode": "auto" }
    },

    {
      "id": 2, "type": "stat",
      "title": "Online Breakers",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{ "refId": "A", "query": "from(bucket: \"energy\")\n  |> range(start: -3m)\n  |> filter(fn: (r) => r._measurement == \"W\" and r._field == \"value\")\n  |> last()\n  |> group()\n  |> count()" }],
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "fixed", "fixedColor": "green" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null}] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "orientation": "auto", "justifyMode": "auto" }
    },

    {
      "id": 3, "type": "stat",
      "title": "Mean Voltage",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{ "refId": "A", "query": "from(bucket: \"energy\")\n  |> range(start: -3m)\n  |> filter(fn: (r) => r._measurement == \"V\" and r._field == \"value\")\n  |> last()\n  |> mean()" }],
      "fieldConfig": { "defaults": { "unit": "volt", "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":null},{"color":"yellow","value":207},{"color":"green","value":215},{"color":"yellow","value":240},{"color":"red","value":253}] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto", "justifyMode": "auto" }
    },

    {
      "id": 4, "type": "stat",
      "title": "Today's Energy",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{ "refId": "A", "query": "from(bucket: \"energy\")\n  |> range(start: today())\n  |> filter(fn: (r) => r._measurement == \"kWh\" and r._field == \"value\")\n  |> difference(nonNegative: true)\n  |> filter(fn: (r) => r._value >= 0.0)\n  |> sum()" }],
      "fieldConfig": { "defaults": { "unit": "kwatth", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "semi-dark-green" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null}] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto", "justifyMode": "auto" }
    },

    {
      "id": 5, "type": "stat",
      "title": "Est. Daily Cost",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{ "refId": "A", "query": "from(bucket: \"energy\")\n  |> range(start: -3m)\n  |> filter(fn: (r) => r._measurement == \"W\" and r._field == \"value\")\n  |> last()\n  |> sum()\n  |> map(fn: (r) => ({r with _value: r._value / 1000.0 * 24.0 * 0.09}))" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "orange" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null}] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto", "justifyMode": "auto" }
    },

    {
      "id": 6, "type": "stat",
      "title": "Total Current",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{ "refId": "A", "query": "from(bucket: \"energy\")\n  |> range(start: -3m)\n  |> filter(fn: (r) => r._measurement == \"A\" and r._field == \"value\")\n  |> last()\n  |> sum()" }],
      "fieldConfig": { "defaults": { "unit": "amp", "decimals": 1, "color": { "mode": "fixed", "fixedColor": "semi-dark-orange" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null}] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto", "justifyMode": "auto" }
    },

    {
      "collapsed": false,
      "id": 101,
      "type": "row",
      "title": "Per-Breaker Stats (like old dashboard)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },

    {
      "id": 11, "type": "stat",
      "title": "Per-Breaker — Power (W)",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 6 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{ "refId": "A", "query": "from(bucket: \"energy\")\n  |> range(start: -3m)\n  |> filter(fn: (r) => r._measurement == \"W\" and r._field == \"value\")\n  |> last()" }],
      "fieldConfig": {
        "defaults": { "unit": "watt", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":800},{"color":"red","value":1600}] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "orientation": "auto", "justifyMode": "auto" }
    },

    {
      "id": 12, "type": "stat",
      "title": "Per-Breaker — Current (A)",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 6 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{ "refId": "A", "query": "from(bucket: \"energy\")\n  |> range(start: -3m)\n  |> filter(fn: (r) => r._measurement == \"A\" and r._field == \"value\")\n  |> last()" }],
      "fieldConfig": {
        "defaults": { "unit": "amp", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":14},{"color":"red","value":17}] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "orientation": "auto", "justifyMode": "auto" }
    },

    {
      "id": 13, "type": "stat",
      "title": "Per-Breaker — Voltage (V)",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 6 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{ "refId": "A", "query": "from(bucket: \"energy\")\n  |> range(start: -3m)\n  |> filter(fn: (r) => r._measurement == \"V\" and r._field == \"value\")\n  |> last()" }],
      "fieldConfig": {
        "defaults": { "unit": "volt", "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":null},{"color":"yellow","value":207},{"color":"green","value":215},{"color":"yellow","value":240},{"color":"red","value":253}] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "orientation": "auto", "justifyMode": "auto" }
    },

    {
      "id": 14, "type": "stat",
      "title": "Per-Breaker — Total Energy (kWh)",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 11 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{ "refId": "A", "query": "from(bucket: \"energy\")\n  |> range(start: -3m)\n  |> filter(fn: (r) => r._measurement == \"kWh\" and r._field == \"value\")\n  |> last()" }],
      "fieldConfig": {
        "defaults": { "unit": "kwatth", "decimals": 3, "color": { "mode": "fixed", "fixedColor": "semi-dark-green" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null}] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "orientation": "auto", "justifyMode": "auto" }
    },

    {
      "collapsed": false,
      "id": 102,
      "type": "row",
      "title": "Power Graphs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }
    },

    {
      "id": 20, "type": "timeseries",
      "title": "Total Power — All Breakers",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{ "refId": "A", "query": "from(bucket: \"energy\")\n  |> range(start: $__timeRangeFrom, stop: $__timeRangeTo)\n  |> filter(fn: (r) => r._measurement == \"W\" and r._field == \"value\")\n  |> aggregateWindow(every: $__interval, fn: sum, createEmpty: false)\n  |> map(fn: (r) => ({r with _value: r._value / 1000.0}))\n  |> yield(name: \"total_kW\")" }],
      "fieldConfig": { "defaults": { "unit": "kwatt", "color": { "mode": "fixed", "fixedColor": "blue" }, "custom": { "lineWidth": 2, "fillOpacity": 20, "gradientMode": "opacity", "showPoints": "never", "spanNulls": false } }, "overrides": [] },
      "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] } }
    },

    {
      "id": 21, "type": "timeseries",
      "title": "Per-Breaker Power (W)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{ "refId": "A", "query": "from(bucket: \"energy\")\n  |> range(start: $__timeRangeFrom, stop: $__timeRangeTo)\n  |> filter(fn: (r) => r._measurement == \"W\" and r._field == \"value\")\n  |> aggregateWindow(every: $__interval, fn: mean, createEmpty: false)\n  |> yield(name: \"power_W\")" }],
      "fieldConfig": { "defaults": { "unit": "watt", "custom": { "lineWidth": 1, "fillOpacity": 5, "showPoints": "never", "spanNulls": false } }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"] } }
    },

    {
      "id": 22, "type": "timeseries",
      "title": "Per-Breaker Current (A)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{ "refId": "A", "query": "from(bucket: \"energy\")\n  |> range(start: $__timeRangeFrom, stop: $__timeRangeTo)\n  |> filter(fn: (r) => r._measurement == \"A\" and r._field == \"value\")\n  |> aggregateWindow(every: $__interval, fn: mean, createEmpty: false)" }],
      "fieldConfig": { "defaults": { "unit": "amp", "custom": { "lineWidth": 1, "fillOpacity": 5, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":14},{"color":"red","value":17}] } }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } }
    },

    {
      "id": 23, "type": "timeseries",
      "title": "Per-Breaker Voltage (V)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{ "refId": "A", "query": "from(bucket: \"energy\")\n  |> range(start: $__timeRangeFrom, stop: $__timeRangeTo)\n  |> filter(fn: (r) => r._measurement == \"V\" and r._field == \"value\")\n  |> aggregateWindow(every: $__interval, fn: mean, createEmpty: false)" }],
      "fieldConfig": {
        "defaults": { "unit": "volt", "decimals": 1, "custom": { "lineWidth": 1, "fillOpacity": 5, "showPoints": "never", "spanNulls": false } },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] }
      }
    },

    {
      "collapsed": false,
      "id": 103,
      "type": "row",
      "title": "NEW — Fleet Table & Top Consumers",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }
    },

    {
      "id": 30, "type": "table",
      "title": "Fleet Overview — All Breakers",
      "gridPos": { "h": 12, "w": 14, "x": 0, "y": 35 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [
        { "refId": "A", "query": "from(bucket: \"energy\")\n  |> range(start: -3m)\n  |> filter(fn: (r) => r._measurement == \"W\" and r._field == \"value\")\n  |> last()\n  |> rename(columns: {_value: \"Power (W)\"})\n  |> keep(columns: [\"entity_id\", \"Power (W)\"])" },
        { "refId": "B", "query": "from(bucket: \"energy\")\n  |> range(start: -3m)\n  |> filter(fn: (r) => r._measurement == \"A\" and r._field == \"value\")\n  |> last()\n  |> rename(columns: {_value: \"Current (A)\"})\n  |> keep(columns: [\"entity_id\", \"Current (A)\"])" },
        { "refId": "C", "query": "from(bucket: \"energy\")\n  |> range(start: -3m)\n  |> filter(fn: (r) => r._measurement == \"V\" and r._field == \"value\")\n  |> last()\n  |> rename(columns: {_value: \"Voltage (V)\"})\n  |> keep(columns: [\"entity_id\", \"Voltage (V)\"])" }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Power (W)" }, "properties": [{ "id": "unit", "value": "watt" },{ "id": "decimals", "value": 0 },{ "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },{ "id": "thresholds", "value": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":800},{"color":"red","value":1600}] } }] },
          { "matcher": { "id": "byName", "options": "Current (A)" }, "properties": [{ "id": "unit", "value": "amp" },{ "id": "decimals", "value": 2 },{ "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },{ "id": "thresholds", "value": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":14},{"color":"red","value":17}] } }] },
          { "matcher": { "id": "byName", "options": "Voltage (V)" }, "properties": [{ "id": "unit", "value": "volt" },{ "id": "decimals", "value": 1 },{ "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },{ "id": "thresholds", "value": { "mode": "absolute", "steps": [{"color":"red","value":null},{"color":"yellow","value":207},{"color":"green","value":215},{"color":"yellow","value":240},{"color":"red","value":253}] } }] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Power (W)", "desc": true }] },
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "renameByName": { "entity_id": "Breaker" } } }
      ]
    },

    {
      "id": 31, "type": "bargauge",
      "title": "NEW — Top Consumers (live power)",
      "gridPos": { "h": 12, "w": 10, "x": 14, "y": 35 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{ "refId": "A", "query": "from(bucket: \"energy\")\n  |> range(start: -3m)\n  |> filter(fn: (r) => r._measurement == \"W\" and r._field == \"value\")\n  |> last()\n  |> sort(columns: [\"_value\"], desc: true)\n  |> limit(n: 12)" }],
      "fieldConfig": {
        "defaults": { "unit": "watt", "decimals": 0, "min": 0, "max": 3000, "color": { "mode": "continuous-BlPu" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":800},{"color":"red","value":1600}] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true, "minVizWidth": 0, "minVizHeight": 10, "namePlacement": "auto", "valueMode": "color" }
    },

    {
      "collapsed": false,
      "id": 104,
      "type": "row",
      "title": "NEW — Load Gauges",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 47 }
    },

    {
      "id": 40, "type": "gauge",
      "title": "NEW — Load % of Rated 20 A per Breaker",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 48 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{ "refId": "A", "query": "from(bucket: \"energy\")\n  |> range(start: -3m)\n  |> filter(fn: (r) => r._measurement == \"A\" and r._field == \"value\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: r._value / 20.0 * 100.0}))" }],
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 0, "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":70},{"color":"red","value":85}] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true }
    },

    {
      "collapsed": false,
      "id": 105,
      "type": "row",
      "title": "Energy Consumption",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 58 }
    },

    {
      "id": 50, "type": "timeseries",
      "title": "Per-Breaker Energy — Cumulative (kWh)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 59 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{ "refId": "A", "query": "from(bucket: \"energy\")\n  |> range(start: $__timeRangeFrom, stop: $__timeRangeTo)\n  |> filter(fn: (r) => r._measurement == \"kWh\" and r._field == \"value\")\n  |> aggregateWindow(every: $__interval, fn: last, createEmpty: false)" }],
      "fieldConfig": { "defaults": { "unit": "kwatth", "decimals": 3, "custom": { "lineWidth": 1, "fillOpacity": 5, "showPoints": "never", "spanNulls": false } }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } }
    },

    {
      "id": 51, "type": "timeseries",
      "title": "NEW — Daily Energy Delta (kWh consumed/day)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 59 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "targets": [{ "refId": "A", "query": "from(bucket: \"energy\")\n  |> range(start: $__timeRangeFrom, stop: $__timeRangeTo)\n  |> filter(fn: (r) => r._measurement == \"kWh\" and r._field == \"value\")\n  |> aggregateWindow(every: 1d, fn: last, createEmpty: false)\n  |> difference(nonNegative: true)\n  |> filter(fn: (r) => r._value >= 0.0)" }],
      "fieldConfig": {
        "defaults": { "unit": "kwatth", "decimals": 2, "custom": { "lineWidth": 0, "fillOpacity": 80, "drawStyle": "bars", "barAlignment": 0, "showPoints": "never", "spanNulls": false } },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "mean", "max"] } }
    },

    {
      "collapsed": false,
      "id": 106,
      "type": "row",
      "title": "Cost",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 68 }
    },

    {
      "id": 60, "type": "stat",
      "title": "Cost — Today",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 69 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
