# Copy to /etc/syslog-ml/indexer.env, fill in real values if you change the
# defaults, and:
#   chmod 600 /etc/syslog-ml/indexer.env
#   chown syslog-ml:syslog-ml /etc/syslog-ml/indexer.env
#
# No secrets in here today (OpenSearch and Ollama are assumed unauthenticated
# on localhost, same trust boundary as ClickHouse) -- kept as an
# EnvironmentFile anyway for consistency with resolver.env, and so auth can
# be added later without touching the unit file.

OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=syslog_logs

OLLAMA_HOST=http://localhost:11434
# Must match web/backend's SYSLOG_ML_OLLAMA_EMBED_MODEL -- the indexer and
# the web app's query-time embedding have to use the same model, or
# similarity search is comparing vectors from two different embedding
# spaces and the results are meaningless.
OLLAMA_EMBED_MODEL=nomic-embed-text
# Must match nomic-embed-text's actual output dimension (768). Only change
# this if you also change OLLAMA_EMBED_MODEL to one with a different
# dimension -- and if you do, delete and recreate the OpenSearch index
# first, since an existing index's knn_vector dimension can't be altered.
EMBED_DIMENSION=768
